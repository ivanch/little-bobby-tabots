# Bobby TaBot — Local Environment
# Copy this file to .env and fill in your token.
# .env is gitignored and will never be committed.

DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_server_id_here

# Voice channel used when the dashboard starts playback before the bot has joined.
# Once connected, the dashboard keeps using the bot's current voice channel.
VOICE_CHANNEL_ID=your_voice_channel_id_here

# Optional: dashboard listen address (defaults to 0.0.0.0:3000)
# WEB_BIND=0.0.0.0:3000

# Optional: default YouTube clip and probability for /preplay
# PREPLAY_URL=https://www.youtube.com/watch?v=your_video_id
# PREPLAY_CHANCE_PERCENT=75

# Folder that Docker Compose mounts read-only at /playlists.
# Each direct .txt file becomes a predefined playlist named after its filename.
PLAYLISTS_HOST_DIR=./playlists

# Optional for local (non-Docker) runs. When PLAYLISTS_HOST_DIR is unset,
# Docker Compose also accepts this as the host bind path before using /playlists inside the container.
# PLAYLISTS_DIR=./playlists

# Optional: control log verbosity
# RUST_LOG=bobby_tabot=debug,songbird=info,serenity=warn
